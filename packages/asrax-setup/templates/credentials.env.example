# ~/.asrax/credentials.env — laptop tokens (never commit).
# Override home via ASRAX_HOME.
# Service secrets: credentials.d/<service>.env
# Shared org keys: optional vault pull -> credentials.vault.env
# Merge: process env > credentials.env > credentials.d/*.env > credentials.vault.env

# --- Personal (required): GitHub + Postman ---
GITHUB_PERSONAL_ACCESS_TOKEN=
GHCR_TOKEN=
GITHUB_TOKEN=
GHCR_USERNAME=
POSTMAN_API_KEY=
# POSTMAN_WORKSPACE_ID=

# --- AM MCP Hub (asrax MCP) ---
ASRAX_MCP_URL=https://am-dev.asrax.in/mcp/sse
ASRAX_MCP_TRANSPORT=sse-only
# Prefer one of:
# ASRAX_KEY_ID=
# ASRAX_KEY_SECRET=
AM_MCP_CLIENT_ID=
AM_MCP_CLIENT_SECRET=
# KEYCLOAK_TOKEN_URL=https://auth.munish.org/auth/realms/am-dev-realm/protocol/openid-connect/token

# --- Bootstrap for Vault ---
VAULT_ADDR=https://vault.asrax.in
VAULT_TOKEN=
